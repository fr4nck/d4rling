+extern "C" OSErr FSRead(
+    short refNum, long* count, void* buffer)
+{
+    if (!count)
+        return paramErr;
+
+    if (*count < 0 || (*count && !buffer))
+        return paramErr;
+
+    ByteCount requested = (ByteCount)*count;
+    ByteCount actual = 0;
+
+    OSErr result = FSReadFork(
+        refNum, fsAtMark, 0,
+        requested, buffer, &actual);
+
+    *count = (long)actual;
+    return result;
+}
+
+extern "C" OSErr FSWrite(
+    short refNum, long* count, const void* buffer)
+{
+    if (!count)
+        return paramErr;
+
+    if (*count < 0 || (*count && !buffer))
+        return paramErr;
+
+    ByteCount requested = (ByteCount)*count;
+    ByteCount actual = 0;
+
+    OSErr result = FSWriteFork(
+        refNum, fsAtMark, 0,
+        requested, buffer, &actual);
+
+    *count = (long)actual;
+    return result;
+}
+
