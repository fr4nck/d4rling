+// Classic File Manager ABI, packed on two-byte boundaries.
+// This is an internal view of the historical IOParam record,
+// not a new public FSForkIOParam layout.
+#pragma pack(push, 2)
+struct ClassicIOParamView {
+    void* qLink;
+    SInt16 qType;
+    SInt16 ioTrap;
+    Ptr ioCmdAddr;
+    void (*ioCompletion)(void*);
+    volatile OSErr ioResult;
+    StringPtr ioNamePtr;
+    SInt16 ioVRefNum;
+    SInt16 ioRefNum;
+    SInt8 ioVersNum;
+    SInt8 ioPermssn;
+    Ptr ioMisc;
+    Ptr ioBuffer;
+    SInt32 ioReqCount;
+    SInt32 ioActCount;
+    SInt16 ioPosMode;
+    SInt32 ioPosOffset;
+};
+#pragma pack(pop)
+
+static_assert(sizeof(void*) == 4, "Classic ABI requires i386");
+static_assert(sizeof(ClassicIOParamView) == 50, "IOParam size");
+static_assert(__builtin_offsetof(ClassicIOParamView, ioResult) == 16,
+              "IOParam result offset");
+static_assert(__builtin_offsetof(ClassicIOParamView, ioRefNum) == 24,
+              "IOParam refnum offset");
+static_assert(__builtin_offsetof(ClassicIOParamView, ioBuffer) == 32,
+              "IOParam buffer offset");
+static_assert(__builtin_offsetof(ClassicIOParamView, ioReqCount) == 36,
+              "IOParam request offset");
+static_assert(__builtin_offsetof(ClassicIOParamView, ioActCount) == 40,
+              "IOParam actual offset");
+static_assert(__builtin_offsetof(ClassicIOParamView, ioPosMode) == 44,
+              "IOParam mode offset");
+static_assert(__builtin_offsetof(ClassicIOParamView, ioPosOffset) == 46,
+              "IOParam position offset");
+
+static OSErr classicPBTransfer(
+    ClassicIOParamView* pb, Boolean async, bool writing)
+{
+    if (!pb)
+        return paramErr;
+
+    pb->ioActCount = 0;
+
+    // Do not emulate asynchronous completion synchronously.
+    if (async) {
+        pb->ioResult = unimpErr;
+        return unimpErr;
+    }
+
+    if (pb->ioReqCount < 0 ||
+        (pb->ioReqCount != 0 && !pb->ioBuffer)) {
+        pb->ioResult = paramErr;
+        return paramErr;
+    }
+
+    ByteCount actual = 0;
+    OSErr result;
+
+    if (writing) {
+        result = FSWriteFork(
+            pb->ioRefNum,
+            (UInt16)pb->ioPosMode,
+            (SInt64)pb->ioPosOffset,
+            (ByteCount)pb->ioReqCount,
+            pb->ioBuffer,
+            &actual);
+    } else {
+        result = FSReadFork(
+            pb->ioRefNum,
+            (UInt16)pb->ioPosMode,
+            (SInt64)pb->ioPosOffset,
+            (ByteCount)pb->ioReqCount,
+            pb->ioBuffer,
+            &actual);
+    }
+
+    pb->ioActCount = (SInt32)actual;
+
+    SInt64 mark = 0;
+    OSErr positionResult =
+        FSGetForkPosition(pb->ioRefNum, &mark);
+
+    if (positionResult == noErr) {
+        if (mark >= 0 && mark <= 2147483647LL)
+            pb->ioPosOffset = (SInt32)mark;
+        else if (result == noErr)
+            result = posErr;
+    } else if (result == noErr) {
+        result = positionResult;
+    }
+
+    pb->ioResult = result;
+    return result;
+}
+
+extern "C" OSErr PBRead(
+    ClassicIOParamView* pb, Boolean async)
+{
+    return classicPBTransfer(pb, async, false);
+}
+
+extern "C" OSErr PBWrite(
+    ClassicIOParamView* pb, Boolean async)
+{
+    return classicPBTransfer(pb, async, true);
+}
+
+
+#endif
