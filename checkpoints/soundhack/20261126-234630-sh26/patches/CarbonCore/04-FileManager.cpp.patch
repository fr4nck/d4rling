+static OSErr sh24VolumeResult(
+    unsigned char* sh24Bytes,OSErr sh24Error)
+{
+    int16_t sh24Value=(int16_t)sh24Error;
+    memcpy(sh24Bytes+offsetof(SH23VolumePB,result),
+           &sh24Value,sizeof(sh24Value));
+    return sh24Error;
+}
