+extern "C" OSErr FSpOpenDF(
+    const FSSpec* spec,
+    SignedByte permission,
+    short* refNum)
+{
+    if (!spec || !refNum)
+        return paramErr;
+
+    FSRef ref;
+    OSErr result = FSpMakeFSRef(spec, &ref);
+
+    if (result != noErr)
+        return result;
+
+    HFSUniStr255 name;
+    result = FSGetDataForkName(&name);
+
+    if (result != noErr)
+        return result;
+
+    FSIORefNum opened;
+    result = FSOpenFork(
+        &ref, name.length, name.unicode,
+        permission, &opened);
+
+    if (result != noErr)
+        return result;
+
+    *refNum = opened;
+    return noErr;
+}
