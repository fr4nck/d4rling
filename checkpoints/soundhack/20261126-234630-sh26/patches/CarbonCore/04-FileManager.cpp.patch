+namespace {
+
+uint32_t sh23LegacyDate(const UTCDateTime& date)
+{
+    return date.highSeconds ? UINT32_MAX : date.lowSeconds;
+}
+
+bool sh23VolumeGeometry(
+    uint64_t total,uint64_t freeBytes,uint32_t nativeBlock,
+    uint32_t* size,uint16_t* blocks,uint16_t* available)
+{
+    if (!nativeBlock || freeBytes>total ||
+        total<nativeBlock)
+        return false;
+
+    uint64_t nativeCount=total/nativeBlock;
+
+    uint64_t multiplier=
+        nativeCount/65535u+
+        (nativeCount%65535u!=0);
+
+    if (!multiplier ||
+        multiplier>UINT32_MAX/nativeBlock)
+        return false;
+
+    uint64_t allocation=multiplier*nativeBlock;
+
+    uint64_t n=total/allocation;
+    uint64_t f=freeBytes/allocation;
+
+    if (!n || n>65535u || f>n)
+        return false;
+
+    *size=(uint32_t)allocation;
+    *blocks=(uint16_t)n;
+    *available=(uint16_t)f;
+
+    return true;
+}
+
+OSErr sh23RootFileCount(uint16_t* result)
+{
+    DIR* dir=opendir("/");
+
+    if (!dir)
+        return ioErr;
+
+    unsigned count=0;
+    OSErr err=noErr;
+
+    for (;;) {
+        errno=0;
+        struct dirent* entry=readdir(dir);
+
+        if (!entry) {
+            if (errno)
+                err=ioErr;
+            break;
+        }
+
+        if (!strcmp(entry->d_name,".") ||
+            !strcmp(entry->d_name,".."))
+            continue;
+
+        char path[4096];
+
+        int n=snprintf(path,sizeof(path),"/%s",entry->d_name);
+
+        if (n<0 || (size_t)n>=sizeof(path)) {
+            err=ioErr;
+            break;
+        }
+
+        struct stat st;
+
+        if (lstat(path,&st)!=0) {
+            if (errno==ENOENT)
+                continue;
+
+            err=ioErr;
+            break;
+        }
+
+        if (!S_ISDIR(st.st_mode) && count<65535u)
+            ++count;
+    }
+
+    closedir(dir);
+
+    if (err==noErr)
+        *result=(uint16_t)count;
+
+    return err;
+}
+
+bool sh23VolumeNameMatches(const unsigned char* name)
+{
+    if (!name || !name[0])
+        return true;
+
+    const char expected[]="Macintosh HD";
+
+    unsigned length=name[0];
+
+    if (length>31)
+        return false;
+
+    if (length && name[length]==':')
+        --length;
+
+    return length==sizeof(expected)-1 &&
+           memcmp(name+1,expected,length)==0;
+}
