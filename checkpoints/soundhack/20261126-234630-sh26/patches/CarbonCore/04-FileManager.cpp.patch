+namespace {
+
+OSErr sh24FlushDescriptor(int fd)
+{
+    int flags=fcntl(fd,F_GETFL);
+
+    if (flags<0)
+        return ioErr;
+
+    if ((flags&O_ACCMODE)==O_RDONLY)
+        return noErr;
+
+    int rc;
+
+    do {
+        rc=fsync(fd);
+    } while (rc<0 && errno==EINTR);
+
+    return rc==0 ? noErr : ioErr;
+}
+
+OSErr sh24FlushOpenForks(
+    const unsigned char* volumeName,short volume)
+{
+    if (volume!=0 && volume!=-100)
+        return nsvErr;
+
+    if (volumeName && volumeName[0]) {
+        unsigned n=volumeName[0];
+
+        if (n>63)
+            return bdNamErr;
+
+        if (volumeName[n]==':')
+            --n;
+
+        if (n!=12 ||
+            memcmp(volumeName+1,"Macintosh HD",12))
+            return nsvErr;
+    }
+
+    std::lock_guard<std::mutex> lock(g_openForksLock);
+
+    OSErr first=noErr;
+
+    for (auto const& entry:g_openForks) {
+        int fd=entry.second.fd;
+
+        // Resource forks currently held in memory are
+        // read-only in this revision.
+        if (fd<0)
+            continue;
+
+        OSErr err=sh24FlushDescriptor(fd);
+
+        if (first==noErr && err!=noErr)
+            first=err;
+    }
+
+    return first;
+}
+
+}
+
+extern "C" OSErr FlushVol(
+    const unsigned char* volumeName,short volume)
+{
+    return sh24FlushOpenForks(volumeName,volume);
+}
