+extern "C" OSErr PBHGetVInfo(
+    HParmBlkPtr sh24Block,Boolean sh24Async)
+{
+    if (!sh24Block)
+        return paramErr;
+
+    // Only the synchronous form is implemented.
+    // No callback is called or queued.
+    auto* sh24PBBytes=reinterpret_cast<unsigned char*>(sh24Block);
+
+    
+
+    if (sh24Async)
+        return sh24VolumeResult(sh24PBBytes,unimpErr);
+
+    SH23VolumePB pb={};
+
+    memcpy(&pb,sh24PBBytes,sizeof(pb));
+
+    FSVolumeRefNum requested=pb.volume;
+    ItemCount index=0;
+
+    if (pb.index>0) {
+        index=(ItemCount)pb.index;
+    } else {
+        if (pb.index<0 &&
+            !sh23VolumeNameMatches(pb.name))
+            return sh24VolumeResult(sh24PBBytes,nsvErr);
+
+        if (requested==0)
+            requested=-100;
+    }
+
+    FSVolumeInfo info={};
+    HFSUniStr255 name={};
+    FSVolumeRefNum actual=0;
+
+    OSErr err=FSGetVolumeInfo(
+        requested,index,&actual,
+        kFSVolInfoGettableInfo,
+        &info,&name,nullptr);
+
+    if (err!=noErr)
+        return sh24VolumeResult(sh24PBBytes,err);
+
+    uint32_t size=0;
+    uint16_t blocks=0,available=0;
+
+    if (!sh23VolumeGeometry(
+        info.totalBytes,info.freeBytes,info.blockSize,
+        &size,&blocks,&available))
+        return sh24VolumeResult(sh24PBBytes,paramErr);
+
+    unsigned char sh26PascalName[32]={};
+
+    if (name.length>31)
+        return sh24VolumeResult(sh24PBBytes,bdNamErr);
+
+    sh26PascalName[0]=(unsigned char)name.length;
+
+    for (unsigned i=0;i<name.length;i++) {
+        if (name.unicode[i]>127)
+            return sh24VolumeResult(sh24PBBytes,unimpErr);
+
+        sh26PascalName[i+1]=(unsigned char)name.unicode[i];
+    }
+
+    uint16_t rootCount=0;
+
+    err=sh23RootFileCount(&rootCount);
+
+    if (err!=noErr)
+        return sh24VolumeResult(sh24PBBytes,err);
+
+    pb.volume=actual;
+    pb.created=sh23LegacyDate(info.createDate);
+    pb.modified=sh23LegacyDate(info.modifyDate);
+
+    // Do not map modern journal/default-volume flags
+    // onto incompatible legacy volume attributes.
+    pb.attributes=
+        (info.flags&kFSVolFlagHardwareLockedMask)
+        ? 0x0080u : 0;
+
+    pb.rootFiles=rootCount;
+
+    // HFS-only internal geometry is unavailable.
+    pb.bitmap=0;
+    pb.allocPtr=0;
+    pb.allocationStart=0;
+
+    pb.totalBlocks=blocks;
+    pb.blockSize=size;
+    pb.clumpSize=info.dataClumpSize;
+    pb.nextID=info.nextCatalogID;
+    pb.freeBlocks=available;
+
+    pb.signature=info.signature;
+    pb.drive=(int16_t)info.driveNumber;
+    pb.driver=(int16_t)info.driverRefNum;
+    pb.filesystemID=(int16_t)info.filesystemID;
+
+    pb.backup=sh23LegacyDate(info.backupDate);
+    pb.sequence=0;
+    pb.writeCount=0;
+    pb.fileCount=info.fileCount;
+    pb.folderCount=info.folderCount;
+
+    memcpy(pb.finderInfo,info.finderInfo,32);
+
+    pb.result=noErr;
+
+    memcpy(sh24PBBytes,&pb,sizeof(pb));
+
+    if (pb.name)
+        memcpy(pb.name,sh26PascalName,(size_t)sh26PascalName[0]+1);
+
+    return noErr;
+}
