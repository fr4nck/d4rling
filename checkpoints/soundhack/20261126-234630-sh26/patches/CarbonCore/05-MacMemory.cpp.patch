+// Classic handle metadata. The master pointer remains the
+// allocator's existing Handle representation.
+static std::mutex g_handleStateMutex;
+
+static std::unordered_map<Handle, unsigned char>& handleStates()
+{
+    static auto* states =
+        new std::unordered_map<Handle, unsigned char>;
+    return *states;
+}
+
+static const unsigned char kHandleLocked = 0x80;
+static const unsigned char kHandlePurgeable = 0x40;
+static const unsigned char kHandleResource = 0x20;
+
+static unsigned char handleState(Handle h)
+{
+    std::lock_guard<std::mutex> guard(g_handleStateMutex);
+    auto it = handleStates().find(h);
+    return it == handleStates().end() ? 0 : it->second;
+}
+
+static void changeHandleState(
+    Handle h, unsigned char clear, unsigned char set)
+{
+    std::lock_guard<std::mutex> guard(g_handleStateMutex);
+
+    auto it = handleStates().find(h);
+
+    if (it != handleStates().end())
+        it->second = (it->second & ~clear) | set;
+}
+
+static Handle makeTrackedHandle(Ptr data)
+{
+    Handle h = (Handle)malloc(sizeof(*h));
+
+    if (!h) {
+        DisposePtr(data);
+        return nullptr;
+    }
+
+    *h = data;
+
+    try {
+        std::lock_guard<std::mutex> guard(g_handleStateMutex);
+        handleStates().emplace(h, 0);
+    } catch (...) {
+        DisposePtr(data);
+        free(h);
+        return nullptr;
+    }
+
+    return h;
+}
+
+extern "C" SignedByte HGetState(Handle h)
+{
+    return (SignedByte)handleState(h);
+}
+
+extern "C" void HSetState(Handle h, SignedByte state)
+{
+    const unsigned char mask =
+        kHandleLocked | kHandlePurgeable | kHandleResource;
+
+    changeHandleState(h, mask, (unsigned char)state & mask);
+}
+
+extern "C" void HNoPurge(Handle h)
+{
+    changeHandleState(h, kHandlePurgeable, 0);
+}
+
+void DisposeHandle(Handle h)
+{
+    if (!h)
+        return;
+
+    {
+        std::lock_guard<std::mutex> guard(g_handleStateMutex);
+        handleStates().erase(h);
+    }
+
+    DisposePtr(*h);
+    free(h);
 }
 
