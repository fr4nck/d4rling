+void sh22Put16(uint8_t* p,uint16_t v)
+{
+    p[0]=(uint8_t)(v>>8);
+    p[1]=(uint8_t)v;
+}
+
+void sh22Put32(uint8_t* p,uint32_t v)
+{
+    p[0]=(uint8_t)(v>>24);
+    p[1]=(uint8_t)(v>>16);
+    p[2]=(uint8_t)(v>>8);
+    p[3]=(uint8_t)v;
+}
+
+// Exact conversion from unsigned 16.16 fixed-point
+// sample rate to the AIFF extended-precision encoding.
+void sh22Rate80(uint8_t* p,uint32_t rate)
+{
+    memset(p,0,10);
+
+    if (!rate)
+        return;
+
+    unsigned highest=0;
+
+    for (uint32_t r=rate;r>1;r>>=1)
+        ++highest;
+
+    uint16_t exponent=(uint16_t)(16383+highest-16);
+    uint64_t mantissa=(uint64_t)rate<<(63-highest);
+
+    sh22Put16(p,exponent);
+
+    for (unsigned n=0;n<8;n++)
+        p[2+n]=(uint8_t)(mantissa>>(56-8*n));
+}
+
+OSErr sh22FrameCount(
+    short channels,short bits,uint32_t rate,
+    unsigned long bytes,uint32_t* frames)
+{
+    if (!rate || channels<1 || channels>2 ||
+        (bits!=8 && bits!=16 && bits!=24 && bits!=32))
+        return paramErr;
+
+    unsigned stride=(unsigned)channels*(unsigned)(bits/8);
+
+    if (bytes>UINT32_MAX || bytes%stride)
+        return paramErr;
+
+    *frames=(uint32_t)(bytes/stride);
+    return noErr;
+}
