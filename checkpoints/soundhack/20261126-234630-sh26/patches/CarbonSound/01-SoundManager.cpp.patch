+extern "C" OSErr SetupAIFFHeader(
+    short ref,short channels,UnsignedFixed rate,
+    short bits,OSType compression,
+    unsigned long bytes,unsigned long suppliedFrames)
+{
+    // Only uncompressed AIFF is implemented.
+    if (compression!=0x4e4f4e45u)
+        return -223;
+
+    uint32_t frames=0;
+
+    OSErr err=sh22FrameCount(
+        channels,bits,rate,bytes,&frames);
+
+    if (err!=noErr)
+        return err;
+
+    if (suppliedFrames && suppliedFrames!=frames)
+        return paramErr;
+
+    uint64_t formSize=46ull+bytes+(bytes&1ul);
+
+    if (formSize>UINT32_MAX)
+        return paramErr;
+
+    uint8_t h[54]={};
+
+    memcpy(h,"FORM",4);
+    sh22Put32(h+4,(uint32_t)formSize);
+    memcpy(h+8,"AIFFCOMM",8);
+
+    sh22Put32(h+16,18);
+    sh22Put16(h+20,(uint16_t)channels);
+    sh22Put32(h+22,frames);
+    sh22Put16(h+26,(uint16_t)bits);
+    sh22Rate80(h+28,rate);
+
+    memcpy(h+38,"SSND",4);
+    sh22Put32(h+42,(uint32_t)(8+bytes));
+
+    // Offset and blockSize remain zero.
+    // Audio payload and odd-byte padding belong to the caller.
+    ByteCount actual=0;
+
+    err=FSWriteFork(
+        ref,fsAtMark,0,sizeof(h),h,&actual);
+
+    if (err!=noErr)
+        return err;
+
+    return actual==sizeof(h) ? noErr : ioErr;
+}
+
+extern "C" OSErr SetupSndHeader(
+    SndListHandle sound,short channels,
+    UnsignedFixed rate,short bits,
+    OSType compression,short note,
+    unsigned long bytes,short* headerLen)
+{
+    if (!headerLen)
+        return paramErr;
+
+    *headerLen=0;
+
+    if (compression!=0x4e4f4e45u)
+        return -223;
+
+    if ((bits!=8 && bits!=16) ||
+        note<0 || note>127)
+        return paramErr;
+
+    uint32_t frames=0;
+
+    OSErr err=sh22FrameCount(
+        channels,bits,rate,bytes,&frames);
+
+    if (err!=noErr)
+        return err;
+
+    Handle h=reinterpret_cast<Handle>(sound);
+
+    if (!h || !*h)
+        return paramErr;
+
+    bool standard=channels==1 && bits==8;
+    unsigned length=standard ? 42 : 84;
+
+    if (GetHandleSize(h)<(Size)length)
+        return memFullErr;
+
+    // Canonical big-endian format-1 resource.
+    // The sampled-sound header begins at offset 20.
+    uint8_t header[84]={};
+
+    sh22Put16(header,1);
+    sh22Put16(header+2,1);
+    sh22Put16(header+4,5);
+
+    sh22Put32(
+        header+6,
+        channels==1 ? 0x80u : 0xc0u
+    );
+
+    sh22Put16(header+10,1);
+    sh22Put16(header+12,0x8051);
+    sh22Put32(header+16,20);
+
+    uint8_t* snd=header+20;
+
+    sh22Put32(snd+4,standard ? frames : channels);
+    sh22Put32(snd+8,rate);
+
+    snd[20]=standard ? 0 : 255;
+    snd[21]=(uint8_t)note;
+
+    if (!standard) {
+        sh22Put32(snd+22,frames);
+        sh22Rate80(snd+26,rate);
+        sh22Put16(snd+48,(uint16_t)bits);
+    }
+
+    memcpy(*h,header,length);
+
+    *headerLen=(short)length;
+    return noErr;
+}
