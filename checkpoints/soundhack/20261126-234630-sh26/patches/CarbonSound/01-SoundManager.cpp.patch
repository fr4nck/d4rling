+struct OpaqueSoundConverter {
+    LegacyPCM input;
+    LegacyPCM output;
+    unsigned channels;
+    unsigned inFrame;
+    unsigned outFrame;
+    bool active;
+};
+
+extern "C" OSErr SoundConverterOpen(
+    const SoundComponentData* input,
+    const SoundComponentData* output,
+    SoundConverter* converter)
+{
+    if (!converter)
+        return paramErr;
+
+    *converter=nullptr;
+
+    if (!input || !output ||
+        !input->sampleRate || !output->sampleRate)
+        return paramErr;
+
+    // This implementation is strictly interleaved PCM.
+    // Extended records, codecs and resampling are excluded.
+    if (input->flags || output->flags ||
+        input->reserved || output->reserved ||
+        input->sampleRate!=output->sampleRate ||
+        input->numChannels!=output->numChannels ||
+        input->numChannels<1 || input->numChannels>2)
+        return unimpErr;
+
+    LegacyPCM in=legacyPCMFormat(*input);
+    LegacyPCM out=legacyPCMFormat(*output);
+
+    if (in==LegacyPCM::Invalid ||
+        out==LegacyPCM::Invalid)
+        return unimpErr;
+
+    auto* c=(OpaqueSoundConverter*)malloc(sizeof(OpaqueSoundConverter));
+
+    if (!c)
+        return memFullErr;
+
+    c->input=in;
+    c->output=out;
+    c->channels=(unsigned)input->numChannels;
+    c->inFrame=c->channels*pcmBytes(in);
+    c->outFrame=c->channels*pcmBytes(out);
+    c->active=false;
+
+    *converter=c;
+    return noErr;
+}
+
+extern "C" OSErr SoundConverterClose(
+    SoundConverter c)
+{
+    if (!c)
+        return paramErr;
+
+    free(c);
+    return noErr;
+}
+
+extern "C" OSErr SoundConverterGetBufferSizes(
+    SoundConverter c,
+    unsigned long target,
+    unsigned long* frames,
+    unsigned long* inputBytes,
+    unsigned long* outputBytes)
+{
+    if (!c || !frames || !inputBytes || !outputBytes)
+        return paramErr;
+
+    *frames=*inputBytes=*outputBytes=0;
+
+    if (target>UINT32_MAX || target<c->inFrame)
+        return paramErr;
+
+    unsigned long n=target/c->inFrame;
+
+    if (n>UINT32_MAX/c->outFrame)
+        return paramErr;
+
+    *frames=n;
+    *inputBytes=n*c->inFrame;
+    *outputBytes=n*c->outFrame;
+    return noErr;
+}
+
+extern "C" OSErr SoundConverterBeginConversion(
+    SoundConverter c)
+{
+    if (!c || c->active)
+        return paramErr;
+
+    c->active=true;
+    return noErr;
+}
+
+extern "C" OSErr SoundConverterConvertBuffer(
+    SoundConverter c,
+    const void* input,
+    unsigned long frames,
+    void* output,
+    unsigned long* outputFrames,
+    unsigned long* outputBytes)
+{
+    if (!outputFrames || !outputBytes)
+        return paramErr;
+
+    *outputFrames=*outputBytes=0;
+
+    if (!c || !c->active)
+        return paramErr;
+
+    if (!frames)
+        return noErr;
+
+    if (!input || !output ||
+        frames>UINT32_MAX/c->inFrame ||
+        frames>UINT32_MAX/c->outFrame)
+        return paramErr;
+
+    size_t inSize=(size_t)frames*c->inFrame;
+    size_t outSize=(size_t)frames*c->outFrame;
+
+    if (c->input==c->output) {
+        memmove(output,input,inSize);
+    } else {
+        // A separate destination protects overlapping buffers.
+        auto* temp=(uint8_t*)malloc(outSize);
+
+        if (!temp)
+            return memFullErr;
+
+        auto* src=(const uint8_t*)input;
+        size_t samples=(size_t)frames*c->channels;
+
+        unsigned inBytes=pcmBytes(c->input);
+        unsigned outBytes=pcmBytes(c->output);
+
+        for (size_t n=0;n<samples;n++) {
+            int32_t value=decodeLegacyPCM(
+                src+n*inBytes,c->input);
+
+            encodeLegacyPCM(
+                temp+n*outBytes,c->output,value);
+        }
+
+        memcpy(output,temp,outSize);
+        free(temp);
+    }
+
+    *outputFrames=frames;
+    *outputBytes=(unsigned long)outSize;
+    return noErr;
+}
+
+extern "C" OSErr SoundConverterEndConversion(
+    SoundConverter c,
+    void* output,
+    unsigned long* frames,
+    unsigned long* bytes)
+{
+    (void)output;
+
+    if (!frames || !bytes)
+        return paramErr;
+
+    *frames=*bytes=0;
+
+    if (!c || !c->active)
+        return paramErr;
+
+    // Equal-rate PCM has no delayed packets to flush.
+    c->active=false;
+    return noErr;
+}
