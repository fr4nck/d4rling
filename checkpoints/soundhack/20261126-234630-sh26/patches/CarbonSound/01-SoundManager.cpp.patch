+namespace {
+
+struct LegacyResourcePCM {
+    uint32_t channels;
+    uint32_t bits;
+    uint32_t rate;
+    uint32_t frames;
+    uint32_t offset;
+    uint32_t length;
+    uint32_t note;
+};
+
+uint16_t resource16(const uint8_t* p)
+{
+    return ((uint16_t)p[0]<<8)|p[1];
+}
+
+uint32_t resource32(const uint8_t* p)
+{
+    return ((uint32_t)p[0]<<24)|
+           ((uint32_t)p[1]<<16)|
+           ((uint32_t)p[2]<<8)|p[3];
+}
+
+bool resourceSpan(size_t total,size_t offset,size_t count)
+{
+    return offset<=total && count<=total-offset;
+}
+
+bool parseLegacyResource(
+    const uint8_t* data,size_t length,LegacyResourcePCM* result)
+{
+    if (!result)
+        return false;
+
+    *result={};
+
+    if (!data || !resourceSpan(length,0,20))
+        return false;
+
+    // Format 1, one sampled-sound modifier,
+    // one offset-based buffer or sound command.
+    if (resource16(data)!=1 ||
+        resource16(data+2)!=1 ||
+        resource16(data+4)!=5 ||
+        resource16(data+10)!=1)
+        return false;
+
+    uint32_t init=resource32(data+6);
+
+    if (init!=0x80u && init!=0xc0u)
+        return false;
+
+    uint16_t command=resource16(data+12);
+
+    if ((command!=0x8051u && command!=0x8050u) ||
+        resource16(data+14)!=0)
+        return false;
+
+    uint32_t offset=resource32(data+16);
+
+    if (offset<20 || !resourceSpan(length,offset,22))
+        return false;
+
+    const uint8_t* h=data+offset;
+
+    // External sample pointers inside a disk resource
+    // cannot be dereferenced safely.
+    if (resource32(h)!=0)
+        return false;
+
+    uint32_t rate=resource32(h+8);
+
+    if (rate<(1000u<<16) || h[21]>127)
+        return false;
+
+    // Looping resources are outside this bounded player.
+    if (resource32(h+12)!=0 || resource32(h+16)!=0)
+        return false;
+
+    uint32_t channels,bits,frames,headerSize;
+
+    if (h[20]==0) {
+        channels=1;
+        bits=8;
+        frames=resource32(h+4);
+        headerSize=22;
+    } else if (h[20]==255) {
+        headerSize=64;
+
+        if (!resourceSpan(length,offset,headerSize))
+            return false;
+
+        channels=resource32(h+4);
+        frames=resource32(h+22);
+        bits=resource16(h+48);
+
+        // Reject external marker/instrument/recording data.
+        if (resource32(h+36) ||
+            resource32(h+40) ||
+            resource32(h+44))
+            return false;
+    } else {
+        return false;
+    }
+
+    if ((channels!=1 && channels!=2) ||
+        (bits!=8 && bits!=16) ||
+        (channels==1 && init!=0x80u) ||
+        (channels==2 && init!=0xc0u))
+        return false;
+
+    // Resource playback is bounded to avoid excessive
+    // allocation in the existing float/resampling engine.
+    if (!frames || frames>4000000u)
+        return false;
+
+    uint64_t bytes=(uint64_t)frames*channels*(bits/8u);
+    uint64_t samplesAt=(uint64_t)offset+headerSize;
+
+    if (bytes>UINT32_MAX || samplesAt>UINT32_MAX ||
+        !resourceSpan(length,(size_t)samplesAt,(size_t)bytes))
+        return false;
+
+    result->channels=channels;
+    result->bits=bits;
+    result->rate=rate;
+    result->frames=frames;
+    result->offset=(uint32_t)samplesAt;
+    result->length=(uint32_t)bytes;
+    result->note=h[21];
+
+    return true;
+}
