+extern "C" OSErr SndPlay(
+    SndChannelPtr chan,SndListHandle resource,Boolean async)
+{
+    Handle h=reinterpret_cast<Handle>(resource);
+
+    if (!h || !*h)
+        return paramErr;
+
+    Size length=GetHandleSize(h);
+
+    if (length<=0)
+        return badFormat;
+
+    LegacyResourcePCM pcm;
+
+    if (!parseLegacyResource(
+        reinterpret_cast<const uint8_t*>(*h),
+        (size_t)length,&pcm))
+        return badFormat;
+
+    // A temporary channel is supported only synchronously.
+    // No untracked background channel or lifetime leak.
+    if (!chan && async)
+        return unimpErr;
+
+    bool temporary=(chan==nullptr);
+
+    if (temporary) {
+        OSErr err=SndNewChannel(
+            &chan,sampledSynth,
+            pcm.channels==1 ? initMono : initStereo,
+            nullptr);
+
+        if (err!=noErr)
+            return err;
+    }
+
+    auto ch=findChannel(chan);
+
+    if (!ch) {
+        if (temporary)
+            SndDisposeChannel(chan,true);
+
+        return badChannel;
+    }
+
+    bool unavailable=false;
+
+    {
+        std::lock_guard<std::mutex> lock(ch->mutex);
+
+        unavailable=ch->disposing ||
+            (!async && (
+                ch->paused ||
+                std::this_thread::get_id()==
+                    ch->callbackThread.get_id()));
+    }
+
+    if (unavailable) {
+        if (temporary)
+            SndDisposeChannel(chan,true);
+
+        return siDeviceBusyErr;
+    }
+
+    // Translate big-endian resource metadata into a native
+    // SoundHeader. The PCM bytes remain in their original
+    // representation. SndDoCommand copies the samples into
+    // the existing engine's owned float buffer before return.
+    SoundHeader standard={};
+    ExtSoundHeader extended={};
+
+    SndCommand cmd={};
+    cmd.cmd=bufferCmd;
+
+    Ptr samples=*h+pcm.offset;
+
+    if (pcm.channels==1 && pcm.bits==8) {
+        standard.samplePtr=samples;
+        standard.length=pcm.frames;
+        standard.sampleRate=pcm.rate;
+        standard.encode=stdSH;
+        standard.baseFrequency=(UInt8)pcm.note;
+
+        cmd.param2=(SInt32)(intptr_t)&standard;
+    } else {
+        extended.samplePtr=samples;
+        extended.numChannels=pcm.channels;
+        extended.sampleRate=pcm.rate;
+        extended.numFrames=pcm.frames;
+        extended.sampleSize=(UInt16)pcm.bits;
+        extended.encode=extSH;
+        extended.baseFrequency=(UInt8)pcm.note;
+
+        cmd.param2=(SInt32)(intptr_t)&extended;
+    }
+
+    OSErr err=noErr;
+
+    try {
+        err=SndDoCommand(chan,&cmd,async);
+
+        if (err==noErr && !async && !temporary) {
+            std::unique_lock<std::mutex> lock(ch->mutex);
+
+            ch->changed.wait(lock,[&] {
+                return ch->disposing ||
+                    (ch->items.empty() && ch->due.empty());
+            });
+
+            if (ch->disposing)
+                err=badChannel;
+        }
+    } catch (const std::bad_alloc&) {
+        err=memFullErr;
+    } catch (...) {
+        err=siDeviceBusyErr;
+    }
+
+    if (temporary) {
+        OSErr disposed=SndDisposeChannel(chan,err!=noErr);
+
+        if (err==noErr)
+            err=disposed;
+    }
+
+    return err;
+}
