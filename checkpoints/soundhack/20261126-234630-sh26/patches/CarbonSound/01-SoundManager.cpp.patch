+enum class LegacyPCM {
+    Invalid,
+    Unsigned8,
+    Signed16BE,
+    Signed16LE
+};
+
+constexpr uint32_t pcmTag(
+    char a, char b, char c, char d)
+{
+    return ((uint32_t)(unsigned char)a<<24) |
+           ((uint32_t)(unsigned char)b<<16) |
+           ((uint32_t)(unsigned char)c<<8) |
+           (uint32_t)(unsigned char)d;
+}
+
+LegacyPCM legacyPCMFormat(const SoundComponentData& d)
+{
+    if (d.format==pcmTag('r','a','w',' ') &&
+        d.sampleSize==8)
+        return LegacyPCM::Unsigned8;
+
+    if (d.format==pcmTag('t','w','o','s') &&
+        d.sampleSize==16)
+        return LegacyPCM::Signed16BE;
+
+    if (d.format==pcmTag('s','o','w','t') &&
+        d.sampleSize==16)
+        return LegacyPCM::Signed16LE;
+
+    return LegacyPCM::Invalid;
+}
+
+unsigned pcmBytes(LegacyPCM f)
+{
+    return f==LegacyPCM::Unsigned8 ? 1 : 2;
+}
+
+int32_t decodeLegacyPCM(
+    const uint8_t* p, LegacyPCM format)
+{
+    if (format==LegacyPCM::Unsigned8)
+        return ((int32_t)p[0]-128)*256;
+
+    uint32_t word;
+
+    if (format==LegacyPCM::Signed16BE)
+        word=((uint32_t)p[0]<<8)|p[1];
+    else
+        word=((uint32_t)p[1]<<8)|p[0];
+
+    return word>=32768
+        ? (int32_t)word-65536
+        : (int32_t)word;
+}
+
+void encodeLegacyPCM(
+    uint8_t* p, LegacyPCM format, int32_t sample)
+{
+    if (format==LegacyPCM::Unsigned8) {
+        p[0]=(uint8_t)((sample+32768)/256);
+        return;
+    }
+
+    uint16_t word=(uint16_t)sample;
+
+    if (format==LegacyPCM::Signed16BE) {
+        p[0]=(uint8_t)(word>>8);
+        p[1]=(uint8_t)word;
+    } else {
+        p[0]=(uint8_t)word;
+        p[1]=(uint8_t)(word>>8);
+    }
+}
