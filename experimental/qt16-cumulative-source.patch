+#define QT16_POINTER_HANDLER 1886679584U
+
+#include "qt16-file.inc"
+#include <dlfcn.h>
+
+/*
+ * Resolve FSSpec only through the real Carbon File Manager.
+ * No fabricated volume IDs, directory IDs or path mappings.
+ */
+static short qt16_open_spec(const FSSpec *spec,
+                            short *out,
+                            SInt8 permission)
+{
+    if(!spec || !out)
+        return QF_PARAM;
+
+    /* Explicitly read-only subset. */
+    if(permission!=1 && permission!=0)
+        return QF_PERMISSION;
+
+    void *cc=dlopen(
+        "/System/Library/Frameworks/"
+        "CoreServices.framework/Versions/A/Frameworks/"
+        "CarbonCore.framework/Versions/A/CarbonCore",
+        RTLD_NOW|RTLD_LOCAL
+    );
+
+    if(!cc)
+        return QF_UNIMPLEMENTED;
+
+    typedef OSErr (*MakeRef)(const FSSpec *,FSRef *);
+    typedef OSStatus (*MakePath)(
+        const FSRef *,UInt8 *,UInt32
+    );
+
+    MakeRef makeRef=(MakeRef)dlsym(cc,"FSpMakeFSRef");
+    MakePath makePath=(MakePath)dlsym(cc,"FSRefMakePath");
+
+    short rc=QF_UNIMPLEMENTED;
+
+    FSRef *ref=malloc(sizeof(*ref));
+    UInt8 *path=malloc(4096);
+
+    if(!ref || !path) {
+        rc=QF_MEMORY;
+    } else if(makeRef && makePath) {
+        rc=makeRef(spec,ref);
+
+        if(!rc) {
+            OSStatus pathError=makePath(ref,path,4096);
+
+            if(pathError)
+                rc=QF_IO;
+            else
+                rc=qf_open((const char *)path,out);
+        }
+    }
+
+    free(path);
+    free(ref);
+    dlclose(cc);
+
+    return rc;
+}
+
+OSErr OpenMovieFile(const FSSpec *fileSpec,
+                    short *resRefNum,
+                    SInt8 permission)
+{
+    OSErr rc=qt16_open_spec(
+        fileSpec,resRefNum,permission
+    );
+
+    movie_error=rc;
+    return rc;
+}
+
+OSErr CloseMovieFile(short resRefNum)
+{
+    OSErr rc=qf_close(resRefNum);
+    movie_error=rc;
+    return rc;
+}
+
+OSErr NewMovieFromFile(Movie *theMovie,
+                       short resRefNum,
+                       short *resId,
+                       Str255 resName,
+                       short newMovieFlags,
+                       Boolean *dataRefWasChanged)
+{
+    if(!theMovie) {
+        movie_error=QF_PARAM;
+        return QF_PARAM;
+    }
+
+    *theMovie=NULL;
+
+    /*
+     * Data-fork MOV only.
+     * Resource-fork movies and unsupported flags are rejected.
+     */
+    if(newMovieFlags!=0 ||
+       (resId && *resId!=0)) {
+        movie_error=QF_UNIMPLEMENTED;
+        return QF_UNIMPLEMENTED;
+    }
+
+    unsigned char *bytes=NULL;
+    int32_t size=0;
+
+    OSErr rc=qf_read(
+        resRefNum,&bytes,&size
+    );
+
+    if(rc) {
+        movie_error=rc;
+        return rc;
+    }
+
+    struct {
+        void *data;
+        int32_t dataLength;
+    } rec;
+
+    rec.data=bytes;
+    rec.dataLength=size;
+
+    void *record=&rec;
+
+    rc=NewMovieFromDataRef(
+        theMovie,0,dataRefWasChanged,
+        (Handle)&record,
+        QT16_POINTER_HANDLER
+    );
+
+    free(bytes);
+
+    if(!rc) {
+        if(resId)
+            *resId=0;
+
+        if(resName)
+            resName[0]=0;
+    }
+
+    movie_error=rc;
+    return rc;
+}
