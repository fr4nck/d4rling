diff --git a/AppKit/NSCell.m b/AppKit/NSCell.m
--- a/AppKit/NSCell.m
+++ b/AppKit/NSCell.m
@@ -435,6 +435,8 @@
 - copyWithZone: (NSZone *) zone {
     NSCell *copy = NSCopyObject(self, 0, zone);
     NS_EXTRA_COPY(NSCell, copy, self);
+    NS_EXTRA(NSCell, copy)->_identifier =
+        [NS_EXTRA(NSCell, self)->_identifier copyWithZone: zone];
 
     NS_EXTRA(NSCell, copy)->_font = [NS_EXTRA(NSCell, self)->_font retain];
     NS_EXTRA(NSCell, copy)->_objectValue = [NS_EXTRA(NSCell, self)->_objectValue copy];
diff --git a/AppKit/NSMenu.subproj/NSMenu.m b/AppKit/NSMenu.subproj/NSMenu.m
--- a/AppKit/NSMenu.subproj/NSMenu.m
+++ b/AppKit/NSMenu.subproj/NSMenu.m
@@ -152,6 +152,8 @@
 - copyWithZone: (NSZone *) zone {
     NSMenu *copy = NSCopyObject(self, 0, zone);
     NS_EXTRA_COPY(NSMenu, copy, self);
+    NS_EXTRA(NSMenu, copy)->_identifier =
+        [NS_EXTRA(NSMenu, self)->_identifier copyWithZone: zone];
 
     copy->_title = [_title copyWithZone: zone];
     NS_EXTRA(NSMenu, copy)->_name = [NS_EXTRA(NSMenu, self)->_name copyWithZone: zone];
