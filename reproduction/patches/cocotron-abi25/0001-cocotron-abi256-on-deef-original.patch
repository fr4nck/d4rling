+int main(void) {
+    setvbuf(stdout, NULL, _IONBF, 0);
+    @autoreleasepool {
+        [appKitClass("NSApplication") sharedApplication];
+        checkTestDeclarations();
+        checkLegacyLayout();
+        checkResponderSubclass();
+        checkViewSubclass();
+        checkWindowSubclass();
+        checkControlSubclasses();
+        checkControllerSubclasses();
+        checkCopies();
+    }
+    if (failures == 0)
+        printf("PASS\n");
+    return failures != 0;
+}
