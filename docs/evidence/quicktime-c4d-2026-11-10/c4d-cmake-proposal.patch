+# Allow a QuickTime-only selection without pulling the GUI stub group.
+if (COMPONENT_gui_stubs OR COMPONENT_quicktime)
+    if (COMPONENT_gui_stubs)
+        set(CMAKE_INSTALL_DEFAULT_COMPONENT_NAME "gui_stubs")
+    else()
+        set(CMAKE_INSTALL_DEFAULT_COMPONENT_NAME "quicktime")
+    endif()
