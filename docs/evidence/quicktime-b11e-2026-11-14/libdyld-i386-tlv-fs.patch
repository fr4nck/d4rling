diff --git a/src/threadLocalHelpers.S b/src/threadLocalHelpers.S
index 4b428a4..f6436ad 100644
--- a/src/threadLocalHelpers.S
+++ b/src/threadLocalHelpers.S
@@ -190,7 +190,14 @@ _hasXSave:			.long 0
 	.private_extern _tlv_get_addr
 _tlv_get_addr:
 	movl	4(%eax),%ecx			// get key from descriptor
+#if defined(DARLING)
+	// Darling i386: Linux owns %gs (glibc TLS); the Darwin TSD is in %fs
+	// (libsyscall os/tsd.h). Reading %gs never finds the block stored by
+	// pthread_setspecific, so every access would allocate a fresh block.
+	movl	%fs:0x0(,%ecx,4),%ecx	// get thread value
+#else
 	movl	%gs:0x0(,%ecx,4),%ecx	// get thread value
+#endif
 	testl	%ecx,%ecx				// if NULL, lazily allocate
 	je		LlazyAllocate
 	movl	8(%eax),%eax			// add offset from descriptor
