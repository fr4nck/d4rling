@@ -24,6 +24,9 @@
 #include <string.h>
 #include "qt_mov_probe.h"
 #include "qt_movie_internal.h"
+#include <CarbonCore/MacMemory.h>
+/* C3 dependency: qualified candidate Memory Manager. */
