+/* E3-B2 MM-C2: experimental logical-size bookkeeping.
+ * Test candidate only, NOT a deployed CarbonCore.
+ * The existing Memory Manager is not thread-safe; this
+ * isolated candidate retains that single-thread limitation.
+ */
+struct D4RLHandleRecord {
+    Ptr master;                 /* first member: Handle ABI */
+    Size logical;
+    D4RLHandleRecord *next;
+};
+
+static D4RLHandleRecord *d4rl_handles = nullptr;
+static OSErr d4rl_last_mem_error = noErr;
+static bool d4rl_qa_fail_realloc = false;
+
+extern "C" OSErr MemError(void)
+{
+    return d4rl_last_mem_error;
+}
+
+extern "C" void d4rl_qa_fail_next_realloc(void)
+{
+    d4rl_qa_fail_realloc = true;
+}
+
+static D4RLHandleRecord *d4rl_find_handle(Handle h)
+{
+    for (D4RLHandleRecord *r = d4rl_handles; r; r = r->next) {
+        if (h == &r->master)
+            return r;
+    }
+    return nullptr;
+}
+
+static Handle d4rl_new_handle(Size logical, bool clear, bool empty)
+{
+    if (logical < 0) {
+        d4rl_last_mem_error = paramErr;
+        return nullptr;
+    }
+
+    D4RLHandleRecord *r =
+        (D4RLHandleRecord *)malloc(sizeof(*r));
+
+    if (!r) {
+        d4rl_last_mem_error = memFullErr;
+        return nullptr;
+    }
+
+    r->master = nullptr;
+
+    if (!empty) {
+        size_t n = logical ? (size_t)logical : 1u;
+        r->master = (Ptr)(clear ? calloc(1, n) : malloc(n));
+
+        if (!r->master) {
+            free(r);
+            d4rl_last_mem_error = memFullErr;
+            return nullptr;
+        }
+    }
+
+    r->logical = logical;
+    r->next = d4rl_handles;
+    d4rl_handles = r;
+    d4rl_last_mem_error = noErr;
+
+    return &r->master;
+}
+
 void DisposeHandle(Handle handle)
 {
-	DisposePtr(*handle);
-	free(handle);
+    D4RLHandleRecord **link = &d4rl_handles;
+
+    while (*link && handle != &(*link)->master)
+        link = &(*link)->next;
+
+    if (!*link) {
+        d4rl_last_mem_error = nilHandleErr;
+        return;
+    }
+
+    D4RLHandleRecord *r = *link;
+    *link = r->next;
+
+    free(r->master);
+    free(r);
+    d4rl_last_mem_error = noErr;
 }
 
